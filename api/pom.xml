<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Spring Boot 3.5.3 を使う。
		start.spring.io は既定で 4.x を返すが、学習中に参照する記事や
		Stack Overflow の回答はほぼ 3.x 向けであり、日本企業の実務も 3.x が主流。
		そのため 3.x を選び、artifactId も 3.x の名前に直してある
		（4.x の starter-webmvc / starter-flyway は 3.x に存在しない）。
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.3</version>
		<relativePath/>
	</parent>

	<groupId>com.mimamori</groupId>
	<artifactId>api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>api</name>
	<description>Mimamori location sharing API</description>

	<properties>
		<java.version>21</java.version>
		<!--
			Spring Boot 3.5.3 が管理する Flyway は 11.7.2 で、
			対応が確認されている PostgreSQL は 17 まで。
			ローカルと Railway が 18 なので、同じメジャー系列の最新に上げる。
			（起動時の「support has not been tested」警告を消すため）
		-->
		<flyway.version>11.20.3</flyway.version>
	</properties>

	<dependencies>
		<!-- REST API -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- リクエストの検証（@Valid, @NotBlank など） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- 認証・認可（F-10 JWT） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- リアルタイム配信（位置・SOS・呼び出し・トーク） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>
		<!-- DB アクセス -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- 死活監視。Railway のヘルスチェックに使う -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
			スキーマ管理。ddl-auto は使わず、SQL を git で管理する。
			3.x では starter が無いので core と DB 方言を個別に入れる。
		-->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- getter/setter などの定型コードを減らす -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- 保存したら自動で再起動する（開発時のみ） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				コード整形。フロントの Prettier にあたるもの。
					mvn spotless:apply  … 整形する
					mvn spotless:check  … 崩れていたら失敗する（コミット前に実行）

				フェーズには紐づけない。npm run dev が Prettier で止まらないのと
				同じで、開発中の実行を整形都合で止めたくないため。

				AOSP スタイル = インデント4スペース。Google 既定の2スペースより
				日本の Java 案件で一般的。
			-->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>3.9.0</version>
				<configuration>
					<java>
						<googleJavaFormat>
							<version>1.36.1</version>
							<style>AOSP</style>
						</googleJavaFormat>
						<!-- 使っていない import を消す。IDE が勝手に足したものを掃除できる -->
						<removeUnusedImports/>
						<importOrder/>
						<trimTrailingWhitespace/>
						<endWithNewline/>
					</java>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
